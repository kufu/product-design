---
import type { MarkdownInstance } from 'astro'

export interface Props {
  documents: MarkdownInstance<{ title: string }>[]
}

const { documents } = Astro.props
---

<ul>
  {
    documents.map((document) => (
      <li>
        <a href={document.url}>{document.frontmatter.title}</a>
      </li>
    ))
  }
</ul>
